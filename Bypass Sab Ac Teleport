local function sha(m)
    local U=4294967296
    local h0,h1,h2,h3,h4,h5,h6,h7=0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19
    local b=#m*8
    m=m.."\128" while #m%64~=56 do m=m.."\0" end
    local function p(n) return string.char(band(rs(n,24),255),band(rs(n,16),255),band(rs(n,8),255),band(n,255)) end
    m=m..p(b//U)..p(b%U)
    local w={}
    for ck=1,#m,64 do
        for i=0,15 do local a,b2,c,d=string.byte(m,ck+i*4,ck+i*4+3) w[i+1]=((a*256+b2)*256+c)*256+d end
        for i=17,64 do local x,y=w[i-15],w[i-2] w[i]=(w[i-16]+bxor(rr(x,7),rr(x,18),rs(x,3))+w[i-7]+bxor(rr(y,17),rr(y,19),rs(y,10)))%U end
        local a,b2,c,d,e,f,g,h=h0,h1,h2,h3,h4,h5,h6,h7
        for i=1,64 do
            local t1=(h+bxor(rr(e,6),rr(e,11),rr(e,25))+bxor(band(e,f),band(bnot(e),g))+K[i]+w[i])%U
            local t2=(bxor(rr(a,2),rr(a,13),rr(a,22))+bxor(band(a,b2),band(a,c),band(b2,c)))%U
            h,g,f,e,d,c,b2,a=g,f,e,(d+t1)%U,c,b2,a,(t1+t2)%U
        end
        h0=(h0+a)%U h1=(h1+b2)%U h2=(h2+c)%U h3=(h3+d)%U h4=(h4+e)%U h5=(h5+f)%U h6=(h6+g)%U h7=(h7+h)%U
    end
    return ("%08x"):rep(8):format(h0,h1,h2,h3,h4,h5,h6,h7)
end

local function cx(s,j)
    local o,p={},0
    for i=1,#s do
        local b=string.byte(s,i)
        if b==47 then o[i]="/" else p=p+1 o[i]=string.char(((b-32+string.byte(j,(p-1)%#j+1))%95)+32) end
    end
    return table.concat(o)
end

